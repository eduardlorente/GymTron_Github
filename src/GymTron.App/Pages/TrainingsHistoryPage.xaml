<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymTron.App.Pages.TrainingsHistoryPage"
             BackgroundColor="{StaticResource GymTronSurface}"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:GymTron.App.Extensions"
             xmlns:converters="clr-namespace:GymTron.App.Converters"
             xmlns:vm="clr-namespace:GymTron.App.ViewModels.Pages"
             xmlns:vmEntities="clr-namespace:GymTron.App.ViewModels.Entities"
             x:DataType="vm:TrainingsHistoryPageViewModel"
             Title="{ext:Translate TrainingsHistory_Title}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#FAF9F6" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:LocalizedFormatConverter x:Key="LocalizedFormatConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20, 16" Spacing="16">
            <CollectionView ItemsSource="{Binding TrainingHistoryItems}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" Padding="20, 60" HorizontalOptions="Center">
                        <Label Text="📅" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="No hay entrenamientos aún"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GymTronDark}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Completa tu primera sesión para consultar aquí tus estadísticas mensuales."
                               FontSize="13"
                               TextColor="{StaticResource GymTronTextMuted}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vmEntities:TrainingHistoryItemViewModel">
                        <Border StrokeShape="RoundRectangle 16"
                                Stroke="{StaticResource GymTronBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource GymTronCardBg}"
                                Padding="16"
                                Margin="0, 6">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="12">

                                <!-- MES I ANY -->
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding Month}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource GymTronDark}" />
                                    <Label Text="{Binding Year}"
                                           FontSize="16"
                                           TextColor="{StaticResource GymTronTextMuted}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <!-- TOTAL MENSUAL -->
                                <Border StrokeShape="RoundRectangle 8"
                                        Stroke="Transparent"
                                        BackgroundColor="{StaticResource GymTronAmberLight}"
                                        Padding="10, 4"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding Count, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter='TrainingsHistory_TotalFormat'}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource GymTronAmberDark}" />
                                </Border>

                                <!-- PER DAY OF WEEK -->
                                <CollectionView ItemsSource="{Binding TrainingDays}"
                                                Margin="0, 4, 0, 0"
                                                ItemsLayout="HorizontalList">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vmEntities:TrainingDayItemViewModel">
                                            <Border StrokeShape="RoundRectangle 10"
                                                    Stroke="{StaticResource GymTronBorder}"
                                                    StrokeThickness="1"
                                                    Padding="12, 8"
                                                    Margin="0, 0, 8, 0"
                                                    BackgroundColor="{StaticResource GymTronSurface}">
                                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                                    <Label Text="{Binding Key, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter='TrainingsHistory_DayFormat'}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource GymTronTextMuted}"
                                                           HorizontalTextAlignment="Center" />
                                                    <Label Text="{Binding Value, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter='TrainingsHistory_CountFormat'}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource GymTronDark}"
                                                           HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
