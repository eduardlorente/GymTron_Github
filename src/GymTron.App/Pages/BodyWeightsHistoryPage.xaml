<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymTron.App.Pages.BodyWeightsHistoryPage"
             BackgroundColor="{StaticResource GymTronSurface}"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:GymTron.App.Extensions"
             xmlns:vm="clr-namespace:GymTron.App.ViewModels.Pages"
             xmlns:vmEntities="clr-namespace:GymTron.App.ViewModels.Entities"
             x:DataType="vm:BodyWeightsHistoryPageViewModel"
             Title="{ext:Translate BodyWeights_Title}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#FAF9F6" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *">

        <!-- Top Action Button -->
        <VerticalStackLayout Grid.Row="0" Padding="20, 16, 20, 8">
            <Button Text="{ext:Translate BodyWeights_Add}"
                    Command="{Binding AddBodyWeightCommand}"
                    BackgroundColor="{StaticResource GymTronAmber}"
                    TextColor="{StaticResource GymTronDark}"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="24"
                    HeightRequest="50">
                <Button.Shadow>
                    <Shadow Brush="#FFBD59" Opacity="0.3" Radius="8" Offset="0, 3" />
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <!-- History List -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20, 8, 20, 20" Spacing="10">
                <CollectionView ItemsSource="{Binding BodyWeightsHistoryItems}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="20, 50" HorizontalOptions="Center">
                            <Label Text="⚖️" FontSize="36" HorizontalOptions="Center" />
                            <Label Text="Sin registros de peso corporal"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource GymTronDark}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Toca el botón superior para registrar tu primer pesaje y seguir tu evolución."
                                   FontSize="13"
                                   TextColor="{StaticResource GymTronTextMuted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vmEntities:BodyWeightHistoryItemViewModel">
                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="{StaticResource GymTronBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource GymTronCardBg}"
                                    Padding="16"
                                    Margin="0, 5">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="12">
                                    <!-- Date Header -->
                                    <Label Text="{Binding CreatedOn}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource GymTronTextMuted}" />

                                    <!-- Metrics Grid -->
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                        <!-- Weight metric -->
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="Transparent"
                                                BackgroundColor="{StaticResource GymTronSurface}"
                                                Padding="12, 8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Peso"
                                                       FontSize="11"
                                                       TextColor="{StaticResource GymTronTextMuted}" />
                                                <Label Text="{Binding Weight}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding WeightColor}" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Body Fat metric -->
                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="Transparent"
                                                BackgroundColor="{StaticResource GymTronSurface}"
                                                Padding="12, 8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="% Grasa"
                                                       FontSize="11"
                                                       TextColor="{StaticResource GymTronTextMuted}" />
                                                <Label Text="{Binding BodyFatPercentage}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding BodyFatPercentageColor}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
