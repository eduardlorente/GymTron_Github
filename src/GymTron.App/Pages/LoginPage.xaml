<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:GymTron.App.ViewModels.Pages"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GymTron.App.Pages.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             BackgroundImageSource="background_image.png"
             Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#FAF9F6" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="24" Padding="24" MaximumWidthRequest="420">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Image Source="icon_app.png"
                       WidthRequest="80"
                       HeightRequest="80"
                       HorizontalOptions="Center" />

                <Label Text="{Binding TitleText}"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource GymTronDark}" />

                <Label Text="{Binding SubtitleText}"
                       FontSize="14"
                       TextColor="{StaticResource GymTronTextMuted}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Form Card -->
            <Border StrokeShape="RoundRectangle 24"
                    StrokeThickness="1"
                    Stroke="{StaticResource GymTronBorder}"
                    BackgroundColor="{StaticResource GymTronCardBg}"
                    Padding="24">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.06" Radius="12" Offset="0, 4" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">

                    <!-- Identifier Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding IdentifierPlaceholder}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GymTronDark}" />
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{StaticResource GymTronBorder}"
                                BackgroundColor="{StaticResource GymTronSurface}"
                                Padding="12,0">
                            <Entry Text="{Binding Identifier}"
                                   Placeholder="{Binding IdentifierPlaceholder}"
                                   PlaceholderColor="{StaticResource GymTronTextMuted}"
                                   Keyboard="Email"
                                   ClearButtonVisibility="WhileEditing"
                                   TextColor="{StaticResource GymTronDark}"
                                   ReturnType="Next"
                                   HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding PasswordPlaceholder}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GymTronDark}" />
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{StaticResource GymTronBorder}"
                                BackgroundColor="{StaticResource GymTronSurface}"
                                Padding="12,0">
                            <Entry Text="{Binding Password}"
                                   Placeholder="{Binding PasswordPlaceholder}"
                                   PlaceholderColor="{StaticResource GymTronTextMuted}"
                                   IsPassword="True"
                                   ClearButtonVisibility="WhileEditing"
                                   TextColor="{StaticResource GymTronDark}"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding LoginCommand}"
                                   HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error message -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#EF4444"
                           FontSize="13"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasError}" />

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource GymTronAmber}"
                                       HorizontalOptions="Center" />

                    <!-- Submit Button -->
                    <Button Text="{Binding SubmitButtonText}"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="{StaticResource GymTronAmber}"
                            TextColor="{StaticResource GymTronDark}"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            HeightRequest="50"
                            FontSize="16">
                        <Button.Shadow>
                            <Shadow Brush="#FFBD59" Opacity="0.3" Radius="8" Offset="0, 3" />
                        </Button.Shadow>
                    </Button>

                    <!-- Biometric Button -->
                    <Button Text="{Binding BiometricButtonText}"
                            Command="{Binding BiometricLoginCommand}"
                            IsVisible="{Binding CanUseBiometric}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource GymTronAmber}"
                            BorderWidth="2"
                            TextColor="{StaticResource GymTronDark}"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            HeightRequest="50"
                            FontSize="16" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
