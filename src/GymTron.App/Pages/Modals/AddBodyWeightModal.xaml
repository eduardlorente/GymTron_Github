<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymTron.App.Pages.Modals.AddBodyWeightModal"
             BackgroundColor="{StaticResource GymTronSurface}"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:GymTron.App.Converters"
             xmlns:ext="clr-namespace:GymTron.App.Extensions"
             xmlns:vm="clr-namespace:GymTron.App.ViewModels.Pages.Modals"
             x:DataType="vm:AddBodyWeightModalViewModel"
             Title="{ext:Translate AddBodyWeight_Title}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#FAF9F6" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20, 24" Spacing="20">

            <!-- Input Card -->
            <Border StrokeShape="RoundRectangle 20"
                    Stroke="{StaticResource GymTronBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource GymTronCardBg}"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">

                    <!-- Weight Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{ext:Translate AddBodyWeight_Weight}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GymTronDark}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource GymTronBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource GymTronSurface}"
                                Padding="14, 0">
                            <Entry Keyboard="Numeric"
                                   Text="{Binding Weight}"
                                   Placeholder="ex: 75.5"
                                   PlaceholderColor="{StaticResource GymTronTextMuted}"
                                   TextColor="{StaticResource GymTronDark}"
                                   HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Body Fat Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{ext:Translate AddBodyWeight_BodyFat}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GymTronDark}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource GymTronBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource GymTronSurface}"
                                Padding="14, 0">
                            <Entry Keyboard="Numeric"
                                   Text="{Binding BodyFatPercentage}"
                                   Placeholder="ex: 15.0"
                                   PlaceholderColor="{StaticResource GymTronTextMuted}"
                                   TextColor="{StaticResource GymTronDark}"
                                   HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Complete Action Button -->
            <Button Text="{ext:Translate AddBodyWeight_Complete}"
                    Command="{Binding AddBodyWeightCommand}"
                    BackgroundColor="{StaticResource GymTronAmber}"
                    TextColor="{StaticResource GymTronDark}"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="24"
                    HeightRequest="52">
                <Button.Shadow>
                    <Shadow Brush="#FFBD59" Opacity="0.3" Radius="8" Offset="0, 3" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
