<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:GymTron.App.Extensions"
             xmlns:vm="clr-namespace:GymTron.App.ViewModels.Pages"
             x:Class="GymTron.App.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel"
             Title="{ext:Translate Settings_Title}"
             BackgroundColor="{StaticResource GymTronSurface}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#FAF9F6" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20, 16" Spacing="16">

            <!-- Language Settings Section -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource GymTronBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource GymTronCardBg}"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding LanguageSectionTitle}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource GymTronDark}" />

                    <Label Text="{Binding LanguageTitle}"
                           FontSize="13"
                           TextColor="{StaticResource GymTronTextMuted}" />

                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource GymTronBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource GymTronSurface}"
                            Padding="12, 0">
                        <Picker ItemsSource="{Binding LanguageNames}"
                                SelectedIndex="{Binding SelectedLanguageIndex}"
                                FontSize="15"
                                TextColor="{StaticResource GymTronDark}"
                                TitleColor="{StaticResource GymTronTextMuted}"
                                HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Security / Biometrics Section -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource GymTronBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource GymTronCardBg}"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding SecuritySectionTitle}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource GymTronDark}" />

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{Binding BiometricsTitle}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GymTronDark}"
                               VerticalOptions="Center" />

                        <Switch Grid.Row="0" Grid.Column="1"
                                IsToggled="{Binding IsBiometricsEnabled}"
                                IsEnabled="{Binding IsBiometricsSupported}"
                                OnColor="{StaticResource GymTronAmber}"
                                ThumbColor="White"
                                VerticalOptions="Center" />

                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding BiometricsDesc}"
                               FontSize="13"
                               TextColor="{StaticResource GymTronTextMuted}"
                               IsVisible="{Binding IsBiometricsSupported}" />

                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding BiometricsNotSupportedText}"
                               FontSize="13"
                               TextColor="#EF4444"
                               IsVisible="{Binding ShowBiometricsNotSupported}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Backup Section -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource GymTronBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource GymTronCardBg}"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding BackupSectionTitle}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource GymTronDark}" />

                    <Label Text="{Binding BackupDesc}"
                           FontSize="13"
                           TextColor="{StaticResource GymTronTextMuted}" />

                    <Button Text="{Binding BackupButtonText}"
                            Command="{Binding ExportBackupCommand}"
                            IsEnabled="{Binding IsNotExportingBackup}"
                            BackgroundColor="{StaticResource GymTronAmber}"
                            TextColor="{StaticResource GymTronDark}"
                            CornerRadius="24"
                            HeightRequest="50"
                            FontSize="15"
                            FontAttributes="Bold">
                        <Button.Shadow>
                            <Shadow Brush="#FFBD59" Opacity="0.25" Radius="8" Offset="0, 2" />
                        </Button.Shadow>
                    </Button>

                    <ActivityIndicator IsRunning="{Binding IsExportingBackup}"
                                       IsVisible="{Binding IsExportingBackup}"
                                       Color="{StaticResource GymTronAmber}"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Account / Logout Section -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#FEE2E2"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource GymTronCardBg}"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding LogoutText}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#DC2626" />

                    <Button Text="{Binding LogoutText}"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="#DC2626"
                            TextColor="White"
                            CornerRadius="24"
                            HeightRequest="50"
                            FontSize="15"
                            FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
