<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymTron.App.Pages.CurrentTrainingPage"
             Shell.BackgroundColor="#ffbd59"
             xmlns:converters="clr-namespace:GymTron.App.Converters"
             xmlns:vm="clr-namespace:GymTron.App.ViewModels.Pages"
             xmlns:vmEntities="clr-namespace:GymTron.App.ViewModels.Entities"
             xmlns:ext="clr-namespace:GymTron.App.Extensions"
             x:DataType="vm:CurrentTrainingPageViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{ext:Translate CurrentTraining_Cancel}" 
                     Command="{Binding CancelTrainingCommand}" 
                     Order="Secondary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto" Margin="20">
        <!-- CONTINGUT SCROLLABLE -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <StackLayout Spacing="5">

                <!-- DATA D'INICI -->
                <Label Text="{ext:Translate CurrentTraining_StartDate}"
                       FontSize="18" />
                <Label Text="{Binding StartTime, StringFormat='{MMMM d, yyyy h:mm tt}'}"
                       FontSize="16"
                       FontAttributes="Bold"
                       Margin="0,0,0,20" />

                <!-- TEMPS TRANSCORREGUT -->
                <Label Text="{ext:Translate CurrentTraining_ElapsedTime}"
                       FontSize="18" />
                <Label Text="{Binding ElapsedTime}"
                       FontSize="16"
                       FontAttributes="Bold"
                       Margin="0,0,0,20" />

                <!-- LLISTA D'EXERCICIS -->
                <Label Grid.Column="0"
                       Text="{ext:Translate CurrentTraining_Exercises}"
                       FontSize="18"
                       VerticalOptions="Center" />

                <CollectionView ItemsSource="{Binding TrainingExercises}" SelectionMode="None" VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vmEntities:ExerciseItemViewModel">
                            <Frame CornerRadius="8" Padding="8" Margin="5"
                                   BackgroundColor="{Binding IsCompleted, Converter={StaticResource BoolToColorConverter}}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="{Binding Name}" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           Grid.Column="0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CurrentTrainingPageViewModel}}, Path=SelectExerciseCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <Image Source="lightning.svg"
                                           WidthRequest="20"
                                           HeightRequest="20"
                                           IsVisible="{Binding AlternatingSeries}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*" Margin="0, 10, 0, 0">
            <Button Grid.Column="0"
                    Text="{ext:Translate CurrentTraining_Finish}"
                    Command="{Binding FinishTrainingCommand}"
                    BackgroundColor="#2C3E50"
                    TextColor="White"
                    CornerRadius="10"
                    HorizontalOptions="Fill" />
        </Grid>
    </Grid>
</ContentPage>