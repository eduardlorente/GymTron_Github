<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymTron.App.Pages.TrainingSummaryPage"
             BackgroundColor="{StaticResource GymTronSurface}"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:GymTron.App.Extensions"
             xmlns:vm="clr-namespace:GymTron.App.ViewModels.Pages"
             xmlns:vmEntities="clr-namespace:GymTron.App.ViewModels.Entities"
             x:DataType="vm:TrainingSummaryPageViewModel"
             Title="{Binding Title}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#FAF9F6" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="*, Auto" Padding="16, 12, 16, 16">
        <!-- SCROLLABLE CONTENT -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16">

                <!-- CELEBRATION HEADER -->
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource GymTronAmberLight}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource GymTronAmberSoft}"
                        Padding="20, 18">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="🏆" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="{Binding CongratulationsText}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GymTronDark}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- METRICS 2x2 GRID -->
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="12" ColumnSpacing="12">
                    <!-- DURATION CARD -->
                    <Border Grid.Row="0" Grid.Column="0"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource GymTronBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource GymTronCardBg}"
                            Padding="14">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.03" Radius="6" Offset="0, 2" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding DurationLabel}" FontSize="12" TextColor="{StaticResource GymTronTextMuted}" />
                            <Label Text="{Binding DurationDisplay}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource GymTronDark}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- EXERCISES CARD -->
                    <Border Grid.Row="0" Grid.Column="1"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource GymTronBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource GymTronCardBg}"
                            Padding="14">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.03" Radius="6" Offset="0, 2" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding ExercisesLabel}" FontSize="12" TextColor="{StaticResource GymTronTextMuted}" />
                            <Label Text="{Binding ExercisesDisplay}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource GymTronDark}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- TOTAL VOLUME CARD -->
                    <Border Grid.Row="1" Grid.Column="0"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource GymTronBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource GymTronCardBg}"
                            Padding="14">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.03" Radius="6" Offset="0, 2" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TotalVolumeLabel}" FontSize="12" TextColor="{StaticResource GymTronTextMuted}" />
                            <Label Text="{Binding VolumeDisplay}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource GymTronAmberDark}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- TOTAL REPS CARD -->
                    <Border Grid.Row="1" Grid.Column="1"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource GymTronBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource GymTronCardBg}"
                            Padding="14">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.03" Radius="6" Offset="0, 2" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TotalRepsLabel}" FontSize="12" TextColor="{StaticResource GymTronTextMuted}" />
                            <Label Text="{Binding RepsDisplay}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource GymTronDark}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- COMPLETED EXERCISES SECTION (COMPACT) -->
                <Label Text="{Binding CompletedExercisesLabel}"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{StaticResource GymTronDark}"
                       Margin="2, 6, 0, 0" />

                <CollectionView ItemsSource="{Binding CompletedExercises}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vmEntities:CompletedExerciseSummaryItem">
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource GymTronBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource GymTronCardBg}"
                                    Padding="14, 10"
                                    Margin="0, 3">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label Grid.Column="0"
                                           Text="✓"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource GymTronSuccess}"
                                           Margin="0, 0, 10, 0"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource GymTronDark}"
                                           VerticalOptions="Center"
                                           LineBreakMode="WordWrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- DONE BUTTON -->
        <Grid Grid.Row="1" Padding="0, 12, 0, 4">
            <Button Text="{Binding DoneButtonText}"
                    Command="{Binding DoneCommand}"
                    BackgroundColor="{StaticResource GymTronAmber}"
                    TextColor="{StaticResource GymTronDark}"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="16"
                    HeightRequest="52"
                    HorizontalOptions="Fill" />
        </Grid>
    </Grid>

</ContentPage>
