<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymTron.App.Pages.ExerciseDetailPage"
             BackgroundColor="{StaticResource GymTronSurface}"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:GymTron.App.Extensions"
             xmlns:vm="clr-namespace:GymTron.App.ViewModels.Pages"
             x:DataType="vm:ExerciseDetailPageViewModel"
             Title="{ext:Translate ExerciseDetail_Title}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#FAF9F6" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto" Padding="20, 16">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="18">

                <!-- EXERCISE HEADER -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding ExerciseName}" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource GymTronDark}" />
                    <Label Text="{Binding Description}" 
                           FontSize="14" 
                           TextColor="{StaticResource GymTronTextMuted}"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding Description, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />
                </VerticalStackLayout>

                <!-- TARGET PARAMETERS CARD -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource GymTronBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource GymTronCardBg}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Objetivo de la Rutina"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GymTronDark}" />

                        <!-- ALTERNATING WARNING -->
                        <Border IsVisible="{Binding AlternatingSeries}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent"
                                BackgroundColor="{StaticResource GymTronAmberLight}"
                                Padding="10, 6">
                            <Label Text="{ext:Translate ExerciseDetail_AlternatingSeries}" 
                                   FontSize="13" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource GymTronAmberDark}" />
                        </Border>

                        <!-- METRICS: SERIES & REPS (2-COLUMN) -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <!-- SERIES -->
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource GymTronBorder}"
                                    BackgroundColor="{StaticResource GymTronSurface}"
                                    Padding="14, 12">
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <Label Text="{Binding Series}" 
                                           FontSize="22" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource GymTronDark}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{ext:Translate ExerciseDetail_Series}" 
                                           FontSize="12" 
                                           TextColor="{StaticResource GymTronTextMuted}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- REPS -->
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource GymTronBorder}"
                                    BackgroundColor="{StaticResource GymTronSurface}"
                                    Padding="14, 12">
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <Label Text="{Binding Repetitions}" 
                                           FontSize="22" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource GymTronDark}"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding RepetitionsTitle}" 
                                           FontSize="12" 
                                           TextColor="{StaticResource GymTronTextMuted}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- REST TIME: FULL-WIDTH ROW -->
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource GymTronBorder}"
                                BackgroundColor="{StaticResource GymTronSurface}"
                                Padding="16, 10">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0"
                                       Text="{ext:Translate ExerciseDetail_Rest}" 
                                       FontSize="13" 
                                       TextColor="{StaticResource GymTronTextMuted}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding RestTime}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource GymTronDark}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- PREVIOUS SESSION LOG CARD -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource GymTronBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource GymTronCardBg}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Historial de la última sesión"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GymTronDark}" />

                        <!-- LAST STATS -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <!-- WEIGHT OR DURATION -->
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{ext:Translate ExerciseDetail_LastWeight}" 
                                       FontSize="12" 
                                       TextColor="{StaticResource GymTronTextMuted}" 
                                       IsVisible="{Binding IsDurationExercise, Converter={StaticResource InvertedBoolConverter}}" />
                                <Label Text="{Binding LastWeightWithSuffix}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource GymTronDark}" 
                                       IsVisible="{Binding IsDurationExercise, Converter={StaticResource InvertedBoolConverter}}" />

                                <Label Text="{ext:Translate ExerciseDetail_LastDuration}" 
                                       FontSize="12" 
                                       TextColor="{StaticResource GymTronTextMuted}" 
                                       IsVisible="{Binding IsDurationExercise}" />
                                <Label Text="{Binding LastDurationWithSufix}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource GymTronDark}" 
                                       IsVisible="{Binding IsDurationExercise}" />
                            </VerticalStackLayout>

                            <!-- REPS -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" IsVisible="{Binding IsDurationExercise, Converter={StaticResource InvertedBoolConverter}}">
                                <Label Text="{ext:Translate ExerciseDetail_LastReps}" 
                                       FontSize="12" 
                                       TextColor="{StaticResource GymTronTextMuted}" />
                                <Label Text="{Binding LastRepetitions}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource GymTronDark}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- OBSERVATIONS -->
                        <VerticalStackLayout Spacing="6" Margin="0, 4, 0, 0">
                            <Label Text="{ext:Translate ExerciseDetail_LastObservations}" 
                                   FontSize="13" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource GymTronDark}" />
                            <CollectionView ItemsSource="{Binding Observations}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="Auto, *" Margin="0, 2">
                                            <Label Text="•" 
                                                   FontSize="14" 
                                                   TextColor="{StaticResource GymTronAmberDark}"
                                                   Margin="0, 0, 6, 0"
                                                   VerticalOptions="Start" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding .}" 
                                                   FontSize="13" 
                                                   TextColor="{StaticResource GymTronTextMuted}"
                                                   LineBreakMode="WordWrap"
                                                   VerticalOptions="Start" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- COMPLETE BUTTON -->
        <Grid Grid.Row="1" Padding="0, 12, 0, 4">
            <Button Text="{ext:Translate ExerciseDetail_Complete}" 
                    Command="{Binding CompleteExerciseCommand}" 
                    BackgroundColor="{StaticResource GymTronAmber}" 
                    TextColor="{StaticResource GymTronDark}" 
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="16"
                    HeightRequest="52"
                    HorizontalOptions="Fill" />
        </Grid>
    </Grid>

</ContentPage>
