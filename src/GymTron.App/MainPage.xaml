<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:GymTron.App.ViewModels.Pages"
             x:Class="GymTron.App.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             BackgroundColor="{StaticResource GymTronSurface}"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#FAF9F6" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *" Padding="20, 24, 20, 20">
        
        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="12" Margin="0, 10, 0, 20" VerticalOptions="Center">
            <Image Grid.Column="0"
                   Source="icon_app.png"
                   WidthRequest="40"
                   HeightRequest="40"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding GreetingText}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource GymTronDark}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- MAIN SCROLLABLE CONTENT -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16">

                <!-- HERO CARD: ENTRENAR -->
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource GymTronBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource GymTronCardBg}"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.06" Radius="12" Offset="0, 4" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding TrainingText}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource GymTronDark}" />
                                <Label Text="Inicia tu sesión del día o continúa el entreno activo."
                                       FontSize="13"
                                       TextColor="{StaticResource GymTronTextMuted}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    StrokeShape="RoundRectangle 24"
                                    Stroke="Transparent"
                                    BackgroundColor="{StaticResource GymTronAmberLight}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End">
                                <Image Source="training.svg"
                                       WidthRequest="24"
                                       HeightRequest="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <Button Text="{Binding TrainingText}"
                                Command="{Binding NavigateTrainingCommand}"
                                BackgroundColor="{StaticResource GymTronAmber}"
                                TextColor="{StaticResource GymTronDark}"
                                FontAttributes="Bold"
                                FontSize="16"
                                HeightRequest="50"
                                CornerRadius="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- SECTION TITLE -->
                <Label Text="Acceso Rápido"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource GymTronDark}"
                       Margin="2, 8, 0, 0" />

                <!-- 2x2 QUICK ACTIONS GRID -->
                <Grid ColumnDefinitions="*, *"
                      RowDefinitions="Auto, Auto"
                      ColumnSpacing="14"
                      RowSpacing="14">

                    <!-- CARD 1: HISTÓRIC ENTRENAMENTS -->
                    <Border Grid.Row="0" Grid.Column="0"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource GymTronBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource GymTronCardBg}"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateTrainingHistoryCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    BackgroundColor="{StaticResource GymTronAmberLight}"
                                    HorizontalOptions="Start">
                                <Image Source="history.svg"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding TrainingHistoryText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource GymTronDark}"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- CARD 2: HISTÓRIC EXERCISIS -->
                    <Border Grid.Row="0" Grid.Column="1"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource GymTronBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource GymTronCardBg}"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateExerciseHistoryCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    BackgroundColor="{StaticResource GymTronAmberLight}"
                                    HorizontalOptions="Start">
                                <Image Source="charthistogram.svg"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding ExerciseHistoryText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource GymTronDark}"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- CARD 3: MESURES (BODY WEIGHT) -->
                    <Border Grid.Row="1" Grid.Column="0"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource GymTronBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource GymTronCardBg}"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateBodyWeightHistoryCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    BackgroundColor="{StaticResource GymTronAmberLight}"
                                    HorizontalOptions="Start">
                                <Image Source="scale.svg"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding BodyWeightHistoryText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource GymTronDark}"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- CARD 4: CONFIGURACIÓ -->
                    <Border Grid.Row="1" Grid.Column="1"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource GymTronBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource GymTronCardBg}"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.04" Radius="8" Offset="0, 2" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateSettingsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    BackgroundColor="{StaticResource GymTronAmberLight}"
                                    HorizontalOptions="Start">
                                <Image Source="cog.svg"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding SettingsText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource GymTronDark}"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
