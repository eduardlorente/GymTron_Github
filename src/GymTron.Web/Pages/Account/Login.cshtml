@page
@model GymTron.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-person-lock text-primary display-4"></i>
                    <h3 class="mt-2">Sign In</h3>
                    <p class="text-muted small">Enter your credentials to access GymTron</p>
                </div>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Identifier" class="form-label">Username or Email</label>
                        <input asp-for="Input.Identifier" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Input.Identifier" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mt-2">Sign In</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
