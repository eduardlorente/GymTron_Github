@page
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm mx-auto p-4" style="max-width: 500px;">
        <i class="bi bi-shield-lock-fill text-danger display-1 mb-3"></i>
        <h2 class="text-danger">Access Denied</h2>
        <p class="text-muted">You do not have permission to access this resource.</p>
        <a asp-page="/Index" class="btn btn-primary mt-3">Return to Home</a>
    </div>
</div>
