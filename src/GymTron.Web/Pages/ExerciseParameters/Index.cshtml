@page
@model GymTron.Web.Pages.ExerciseParameters.IndexModel
@using GymTron.Domain.Enums
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["ExerciseParameters_Index_PageTitle"];
}

<div class="gt-page-header">
    <div>
        <h1>@Localizer["ExerciseParameters_Index_Title"]</h1>
        <p class="text-muted mb-0">@Localizer["ExerciseParameters_Index_PageTitle"]</p>
    </div>
    <div>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Localizer["ExerciseParameters_Index_CreateNew"]
        </a>
    </div>
</div>

<div class="gt-table-container">
    <div class="table-responsive">
        <table class="gt-table" aria-label="@Localizer["ExerciseParameters_Index_Title"]">
            <thead>
                <tr>
                    <th>@Localizer["ExerciseParameters_Index_Name"]</th>
                    <th>@Localizer["ExerciseParameters_Index_Type"]</th>
                    <th>@Localizer["ExerciseParameters_Index_Pattern"]</th>
                    <th>@Localizer["ExerciseParameters_Index_RIR"]</th>
                    <th class="text-end">@Localizer["ExerciseParameters_Index_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exercise in Model.Exercises)
                {
                    <tr>
                        <td class="fw-semibold">@exercise.Name</td>
                        <td>
                            @if (exercise.Type == ExerciseTypes.WEIGHT)
                            {
                                <span class="gt-badge gt-badge-blue">
                                    <i class="bi bi-heptagon-fill"></i> @exercise.TypeName
                                </span>
                            }
                            else
                            {
                                <span class="gt-badge gt-badge-teal">
                                    <i class="bi bi-clock-fill"></i> @exercise.TypeName
                                </span>
                            }
                        </td>
                        <td>
                            <span class="text-secondary">@exercise.Pattern</span>
                        </td>
                        <td>
                            <span class="fw-medium">@exercise.ReplaysInReserve</span>
                        </td>
                        <td class="text-end">
                            <a asp-page="Edit" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-warning" aria-label="@Localizer["ExerciseParameters_Index_Edit"] @exercise.Name">
                                <i class="bi bi-pencil"></i> @Localizer["ExerciseParameters_Index_Edit"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
