@page
@model ErrorModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Error_Page_Title"];
}

<div class="gt-form-card text-center my-5">
    <div class="gt-card-icon gt-card-icon-blue mx-auto mb-3" style="background-color: var(--gt-danger-soft); color: var(--gt-danger);">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h1 class="h3 fw-bold text-danger mb-2">@Localizer["Error_Page_Title"]</h1>
    <p class="text-muted mb-4">@Localizer["Error_Page_Message"]</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted font-monospace mb-4">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-primary justify-content-center">
        <i class="bi bi-house"></i> Volver al inicio
    </a>
</div>
