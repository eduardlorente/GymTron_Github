@page "{id:int}"
@model GymTron.Web.Pages.Routines.EditModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Routines_Edit_PageTitle"];
}

<div class="gt-page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-page="Index" class="btn btn-secondary btn-sm p-2" aria-label="Volver">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1>@Localizer["Routines_Edit_Title"]</h1>
            <p class="text-muted mb-0">Modifica los detalles y estructura semanal de la rutina</p>
        </div>
    </div>
    <div>
        <button type="submit" form="routineForm" class="btn btn-primary" id="saveButton">
            <i class="bi bi-check2"></i> @Localizer["Routines_Edit_Save"]
        </button>
    </div>
</div>

<form method="post" id="routineForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
    <input type="hidden" asp-for="Routine.Id" />
    
    <div class="gt-card mb-4">
        <label asp-for="Routine.Name" class="form-label fw-bold">@Localizer["Routines_Edit_RoutineName"]</label>
        <input asp-for="Routine.Name" class="form-control form-control-lg" placeholder="e.g. Torso / Pierna 4 días" />
        <span asp-validation-for="Routine.Name" class="text-danger small"></span>
    </div>

    <!-- Weekday pill navigation -->
    <ul class="nav gt-day-nav" id="dayTabs" role="tablist">
        @for (int day = 1; day <= 7; day++)
        {
            var dayName = Model.GetDayName(day);
            var exercisesForDay = Model.GetExercisesForDay(day);
            var activeClass = day == 1 ? "active" : "";
            var ariaSelected = day == 1 ? "true" : "false";
            
            <li class="nav-item" role="presentation">
                <button class="gt-day-pill @activeClass" id="day@(day)-tab" data-bs-toggle="tab" 
                        data-bs-target="#day@(day)" type="button" role="tab" 
                        aria-controls="day@(day)" aria-selected="@ariaSelected">
                    @dayName 
                    @if (exercisesForDay.Count > 0)
                    {
                        <span class="badge rounded-pill bg-light text-dark">@exercisesForDay.Count</span>
                    }
                </button>
            </li>
        }
    </ul>

    <div class="tab-content" id="dayTabsContent">
        @for (int day = 1; day <= 7; day++)
        {
            var dayName = Model.GetDayName(day);
            var exercisesForDay = Model.GetExercisesForDay(day);
            var showClass = day == 1 ? "show active" : "";
            
            <div class="tab-pane fade @showClass" id="day@(day)" role="tabpanel" aria-labelledby="day@(day)-tab">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 fw-bold mb-0">
                        <i class="bi bi-calendar-event text-primary me-2"></i>@Localizer["Routines_Edit_ExercisesOfDay"] @dayName
                    </h2>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="GymTronRoutines.openAddExerciseModal(@day)">
                        <i class="bi bi-plus-circle"></i> @Localizer["Routines_Edit_AddExercise"]
                    </button>
                </div>

                @if (exercisesForDay.Any())
                {
                    <div class="exercise-list">
                        @foreach (var exercise in exercisesForDay)
                        {
                            var globalIndex = Model.Routine.Items.IndexOf(exercise);
                            
                            <input type="hidden" asp-for="Routine.Items[globalIndex].Id" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].DayOfWeek" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].ExerciseParametersId" class="exercise-param-id" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].Series" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].RepetitionsMin" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].RepetitionsMax" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].Duration" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].MinRestTimeInSeconds" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].MaxRestTimeInSeconds" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].AlternatingSeries" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].Position" />
                            <input type="hidden" asp-for="Routine.Items[globalIndex].Type" />
                            
                            <div class="gt-exercise-card" data-index="@globalIndex">
                                <div class="gt-exercise-info">
                                    <span class="gt-badge gt-badge-blue">@exercise.Position</span>
                                    <div class="gt-exercise-name">@exercise.ExerciseName</div>
                                    <div class="gt-exercise-metric">
                                        @if (exercise.Type == GymTron.Domain.Enums.ExerciseTypes.DURATION)
                                        {
                                            <text>@exercise.Series @Localizer["Routines_Edit_SeriesX"] @exercise.Duration @Localizer["Routines_Edit_Seconds"]</text>
                                        }
                                        else
                                        {
                                            <text>@exercise.Series @Localizer["Routines_Edit_SeriesX"] @exercise.RepetitionsMin-@exercise.RepetitionsMax @Localizer["Routines_Edit_Reps"]</text>
                                        }
                                    </div>
                                    <div class="gt-exercise-rest">
                                        <i class="bi bi-clock me-1"></i>@exercise.MinRestTimeInSeconds-@(exercise.MaxRestTimeInSeconds ?? 0) @Localizer["Routines_Edit_Seconds"]
                                    </div>
                                    @if (exercise.AlternatingSeries)
                                    {
                                        <span class="gt-badge gt-badge-teal">
                                            <i class="bi bi-arrow-repeat"></i> @Localizer["Routines_Edit_Alternating"]
                                        </span>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="GymTronRoutines.editExercise(@globalIndex)" title="@Localizer["Routines_Edit_Edit"]" aria-label="@Localizer["Routines_Edit_Edit"] @exercise.ExerciseName">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="submit" name="removeIndex" value="@globalIndex" class="btn btn-sm btn-outline-danger" title="@Localizer["Routines_Edit_Remove"]" aria-label="@Localizer["Routines_Edit_Remove"] @exercise.ExerciseName">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="gt-card text-center py-4">
                        <i class="bi bi-plus-circle text-muted display-6 d-block mb-2"></i>
                        <p class="text-muted mb-3">@Localizer["Routines_Edit_NoExercises"]</p>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="GymTronRoutines.openAddExerciseModal(@day)">
                            <i class="bi bi-plus-lg"></i> @Localizer["Routines_Edit_AddExercise"]
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
        <a asp-page="Index" class="btn btn-secondary" id="cancelButton">@Localizer["Routines_Edit_Back"]</a>
        <button type="submit" class="btn btn-primary" id="saveButtonBottom">
            <i class="bi bi-check2"></i> @Localizer["Routines_Edit_Save"]
        </button>
    </div>
</form>

<!-- Modal para añadir/editar ejercicio -->
<div class="modal fade" id="exerciseModal" tabindex="-1" aria-labelledby="exerciseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--gt-radius);">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="exerciseModalLabel">@Localizer["Routines_Edit_ModalTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="editingIndex" value="-1" />
                <input type="hidden" id="modalExerciseName" value="" />
                <input type="hidden" id="modalDayOfWeek" value="1" />
                
                <div class="mb-3">
                    <label class="form-label" for="modalExercise">@Localizer["Routines_Edit_ModalExercise"]</label>
                    <select id="modalExercise" class="form-select">
                        <option value="">@Localizer["Routines_Edit_ModalSelectExercise"]</option>
                        @foreach (var option in Model.ExerciseOptions)
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    </select>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="modalSeries">@Localizer["Routines_Edit_ModalSeries"]</label>
                        <input type="number" id="modalSeries" class="form-control" min="1" max="20" />
                    </div>
                    <div class="col-md-4 repetitions-group">
                        <label class="form-label" for="modalRepsMin">@Localizer["Routines_Edit_ModalRepsMin"]</label>
                        <input type="number" id="modalRepsMin" class="form-control" min="1" max="100" />
                    </div>
                    <div class="col-md-4 repetitions-group">
                        <label class="form-label" for="modalRepsMax">@Localizer["Routines_Edit_ModalRepsMax"]</label>
                        <input type="number" id="modalRepsMax" class="form-control" min="1" max="100" />
                    </div>
                    <div class="col-md-8 duration-group" style="display: none;">
                        <label class="form-label" for="modalDuration">@Localizer["Routines_Edit_ModalDuration"]</label>
                        <div class="input-group">
                            <input type="number" id="modalDuration" class="form-control" min="0" max="3600" />
                            <span class="input-group-text">segundos</span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="form-label" for="modalRestMin">@Localizer["Routines_Edit_ModalRestMin"]</label>
                        <input type="number" id="modalRestMin" class="form-control" min="0" max="600" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="modalRestMax">@Localizer["Routines_Edit_ModalRestMax"]</label>
                        <input type="number" id="modalRestMax" class="form-control" min="0" max="600" />
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="form-label" for="modalOrder">@Localizer["Routines_Edit_ModalOrder"]</label>
                        <input type="number" id="modalOrder" class="form-control" min="1" />
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check mt-3">
                            <input type="checkbox" id="modalAlternating" class="form-check-input" />
                            <label class="form-check-label" for="modalAlternating">@Localizer["Routines_Edit_ModalAlternating"]</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Routines_Edit_ModalCancel"]</button>
                <button type="button" class="btn btn-primary" onclick="GymTronRoutines.saveExerciseChanges()">
                    <i class="bi bi-check2"></i> @Localizer["Routines_Edit_ModalSave"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/gymtron-routines.js" asp-append-version="true"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            GymTronRoutines.init({
                exerciseTypes: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExerciseTypes)),
                labels: {
                    addTitlePrefix: '@Localizer["Routines_Edit_AddExercise"] -',
                    editTitle: '@Localizer["Routines_Edit_Edit"]',
                    selectExerciseAlert: '@Localizer["Routines_Edit_ModalSelectExercise"]',
                    cancelButtonText: '@Localizer["Routines_Edit_ModalCancel"]',
                    backButtonText: '@Localizer["Routines_Edit_Back"]'
                }
            });
        });
    </script>
}
