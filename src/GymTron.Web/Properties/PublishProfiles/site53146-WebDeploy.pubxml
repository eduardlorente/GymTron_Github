<?xml version="1.0" encoding="utf-8"?>
<!-- Account-specific values must be supplied by ignored local properties or CI secrets. -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>$(GymTronPublishSiteUrl)</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>13b3e226-3667-42d0-b9cf-903e61de935a</ProjectGuid>
    <MSDeployServiceURL>$(GymTronPublishServiceUrl)</MSDeployServiceURL>
    <DeployIisAppPath>$(GymTronPublishIisAppPath)</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>true</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <UserName>$(GymTronPublishUserName)</UserName>
    <_SavePWD>false</_SavePWD>
  </PropertyGroup>
  <Import Project="site53146-WebDeploy.local.props" Condition="Exists('site53146-WebDeploy.local.props')" />
</Project>
